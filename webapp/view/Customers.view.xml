<mvc:View
    controllerName="fr.acollet.flightsdashboard.controller.Customers"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">
    <Page
        id="customersPage"
        title="{i18n>navCustomers}"
        titleAlignment="Auto">
        <content>
            <Table
                id="customersTable"
                growing="true"
                growingThreshold="20"
                width="auto"
                mode="SingleSelectMaster"
                items="{path: '/UX_Customer'}" >
                <headerToolbar>
                    <Toolbar>
                        <ToolbarSpacer />
                        <SearchField
                            width="40%"
                            search=".onFilterCustomers" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <header>
                            <Text text="{i18n>customerNameLabel}" />
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <Text text="{i18n>customerStreetLabel}" />
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <Text text="{i18n>customerPostalLabel}" />
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <Text text="{i18n>customerCityLabel}" />
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <Text text="{i18n>customerCountryLabel}" />
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <Text text="{i18n>customerEmailLabel}" />
                        </header>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem
                        type="Navigation"
                        press=".onCustomerPress">
                        <cells>
                            <ObjectIdentifier title="{CustomerName}" />
                            <Text text="{Street}" />
                            <Text text="{PostCode}" />
                            <Text text="{City}" />
                            <Text text="{Country}" />
                            <Text text="{Email}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
