{
  "_version": "1.60.0",
  "sap.app": {
    "id": "fr.acollet.flightsdashboard",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "4c92d8c0-952a-4158-97dd-ce87aa5e46bd"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "fr.acollet.flightsdashboard.i18n.i18n",
          "supportedLocales": [
            "",
            "fr"
          ]
        }
      },
      "": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "synchronizationMode": "None",
          "autoExpandSelect": true,
          "groupId": "$direct",
          "updateGroupId": "$direct",
          "operationMode": "Server"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "fr.acollet.flightsdashboard.view",
        "async": true,
        "viewPath": "fr.acollet.flightsdashboard.view"
      },
      "routes": [
        {
          "name": "RouteDashboard",
          "pattern": "",
          "target": "TargetDashboard"
        },
        {
          "name": "customers",
          "pattern": "customers",
          "target": "TargetCustomers"
        },
        {
          "name": "bookings",
          "pattern": "bookings",
          "target": "TargetBookings"
        }
      ],
      "targets": {
        "TargetDashboard": {
          "id": "Dashboard",
          "name": "Dashboard"
        },
        "TargetCustomers": {
          "id": "Customers",
          "name": "Customers"
        },
        "TargetBookings": {
          "id": "Bookings",
          "name": "Bookings"
        }
      }
    },
    "rootView": {
      "viewName": "fr.acollet.flightsdashboard.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}